+def triangles_from_normals(
+    centers: torch.Tensor,
+    radii: torch.Tensor,
+    normals: np.ndarray,
+) -> torch.Tensor | None:
+    normal_tensor = torch.as_tensor(normals, dtype=torch.float32, device=centers.device)
+    lengths = torch.linalg.vector_norm(normal_tensor, dim=1, keepdim=True)
+    if not bool(torch.isfinite(normal_tensor).all()) or not bool((lengths > 1e-6).all()):
+        return None
+    unit = normal_tensor / lengths
+    reference = torch.zeros_like(unit)
+    use_y = unit[:, 2].abs() > 0.9
+    reference[:, 2] = 1.0
+    reference[use_y] = reference.new_tensor((0.0, 1.0, 0.0))
+    tangent_u = torch.nn.functional.normalize(torch.linalg.cross(reference, unit), dim=1)
+    tangent_v = torch.linalg.cross(unit, tangent_u)
+    angles = torch.arange(3, dtype=centers.dtype, device=centers.device) * (
+        2.0 * math.pi / 3.0
+    )
+    offsets = (
+        torch.cos(angles)[None, :, None] * tangent_u[:, None, :]
+        + torch.sin(angles)[None, :, None] * tangent_v[:, None, :]
+    )
+    return centers[:, None, :] + radii[:, None, :] * offsets
+
