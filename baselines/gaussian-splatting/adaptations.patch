+def rotations_from_normals(normals: np.ndarray, device: torch.device) -> torch.Tensor | None:
+    normal_tensor = torch.as_tensor(normals, dtype=torch.float32, device=device)
+    lengths = torch.linalg.vector_norm(normal_tensor, dim=1, keepdim=True)
+    if not bool(torch.isfinite(normal_tensor).all()) or not bool((lengths > 1e-6).all()):
+        return None
+    unit = normal_tensor / lengths
+    rotations = torch.stack(
+        (
+            1.0 + unit[:, 2],
+            -unit[:, 1],
+            unit[:, 0],
+            torch.zeros_like(unit[:, 0]),
+        ),
+        dim=1,
+    )
+    antiparallel = torch.linalg.vector_norm(rotations, dim=1) <= 1e-7
+    rotations[antiparallel] = rotations.new_tensor((0.0, 1.0, 0.0, 0.0))
+    return torch.nn.functional.normalize(rotations, dim=1)
 
