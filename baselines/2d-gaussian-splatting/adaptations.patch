+def radius_suppression_mask(points: np.ndarray, radius: float, batch_size: int = 256) -> np.ndarray:
+    """Preserve DTU's greedy order without retaining every radius neighborhood."""
+    tree = skln.KDTree(points, leaf_size=30, metric='euclidean')
+    mask = np.ones(len(points), dtype=np.bool_)
+    for start in range(0, len(points), batch_size):
+        candidates = np.flatnonzero(mask[start:start + batch_size]) + start
+        if not len(candidates):
+            continue
+        neighborhoods = tree.query_radius(points[candidates], r=radius)
+        for current, neighbors in zip(candidates, neighborhoods):
+            if mask[current]:
+                mask[neighbors] = False
+                mask[current] = True
+    return mask
+
 
