+        "complete": True,
+        "iterations": args.iterations,
+        "seed": args.seed,
+        "final_points": final_points,
+        "model_bytes_per_primitive": MODEL_BYTES_PER_PRIMITIVE,
+        "model_state_bytes": final_points * MODEL_BYTES_PER_PRIMITIVE,
+        "wall_time_seconds": time.perf_counter() - training_start,
+        "milestone_wall_time_seconds": milestone_wall_time_seconds,
+        "peak_cuda_allocated_bytes": torch.cuda.max_memory_allocated(),
+        "peak_cuda_reserved_bytes": torch.cuda.max_memory_reserved(),
+        "torch_version": str(torch.__version__),
+        "cuda_version": str(torch.version.cuda),
+        "device_name": torch.cuda.get_device_name(),
+        "argv": sys.argv,
+    }
+    if train_camera_selection is not None:
+        telemetry["train_camera_selection"] = train_camera_selection
+    with open(os.path.join(args.model_path, "training_telemetry.json"), "x") as telemetry_file:
+        json.dump(telemetry, telemetry_file, indent=2)
+        telemetry_file.write("\n")
 
     # All done
     print("\nTraining complete.")
