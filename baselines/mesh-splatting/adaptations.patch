+    def cap_primitives(self, max_primitives):
+        count = self._triangle_indices.shape[0]
+        if max_primitives <= 0 or count <= max_primitives:
+            return
+        if self.importance_score.shape[0] == count:
+            scores = self.importance_score
+        else:
+            scores = self.triangle_areas()
+        keep = torch.topk(scores, max_primitives).indices
+        keep_mask = torch.zeros(count, dtype=torch.bool, device=self.vertices.device)
+        keep_mask[keep] = True
+        self.prune_triangles(keep_mask)
+        used_vertices = torch.zeros(self.vertices.shape[0], dtype=torch.bool, device=self.vertices.device)
+        used_vertices[self._triangle_indices.flatten().long()] = True
+        self._prune_vertices(used_vertices)
+
+    def cap_scene_bytes(self, max_scene_bytes):
+        if max_scene_bytes <= 0:
+            return
+        scene_bytes = self.vertices.shape[0] * 208 + self._triangle_indices.shape[0] * 12
+        while scene_bytes > max_scene_bytes and self._triangle_indices.shape[0] > 1:
+            keep_count = max(
+                1,
+                int(self._triangle_indices.shape[0] * max_scene_bytes / scene_bytes * 0.98),
+            )
