diff --git a/utils/memory_control.py b/utils/memory_control.py
new file mode 100644
--- /dev/null
+++ b/utils/memory_control.py
@@ -0,0 +1,69 @@
+# Modified for the Hexels release: shared protocols and capacity/evaluation adapters.
+"""Accounting and deterministic initialization for no-growth memory controls."""
+
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def select_sfm_indices(population: int, count: int, seed: int) -> np.ndarray:
+    """Choose nested, deterministic subsets while retaining source point order."""
+    if not 4 <= count <= population:
+        raise ValueError(f"Invalid SfM subset: {count} of {population}")
+    return np.sort(np.random.default_rng(seed).permutation(population)[:count])
+
+
+def state_summary(model: object) -> dict:
+    """Count stored model tensors, including int32 face connectivity."""
+    fields = ("vertices", "vertex_weight", "_features_dc", "_features_rest", "_triangle_indices")
+    sizes = {name: getattr(model, name).numel() * getattr(model, name).element_size() for name in fields}
+    return {"vertices": len(model.vertices), "faces": len(model._triangle_indices),
+            "tensor_bytes": sizes, "state_bytes": sum(sizes.values())}
+
+
+def audit_budget(model: object, path: Path, stage: str, budget: int, initial_only: bool = False) -> None:
+    """Enforce the declared budget scope and report byte changes without pruning."""
+    record = json.loads(path.read_text()) if path.exists() else {
+        "budget_bytes": budget, "budget_scope": "initialization" if initial_only else "all_stages", "stages": []}
+    summary = {"stage": stage, **state_summary(model)}
+    summary["delta_bytes"] = summary["state_bytes"] - budget
+    summary["delta_percent"] = 100 * summary["delta_bytes"] / budget
+    summary["overshoot_bytes"] = max(0, summary["delta_bytes"])
+    record["stages"].append(summary)
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(record, indent=2) + "\n")
+    temporary.replace(path)
+    if summary["vertices"] > record["stages"][0]["vertices"]:
+        raise ValueError(f"Vertex growth in no-densification control at {stage}")
+    if summary["state_bytes"] > budget and (stage == "initialization" or not initial_only):
+        raise ValueError(f"Mesh state exceeds budget at {stage}: {summary['state_bytes']} > {budget}")
+
+
+def topology_summary(vertices: np.ndarray, faces: np.ndarray) -> dict:
+    """Measure connectivity and boundary incidence without repairing the mesh."""
+    from scipy.sparse import coo_matrix
+    from scipy.sparse.csgraph import connected_components
+
+    if vertices.ndim != 2 or vertices.shape[1] != 3 or not np.isfinite(vertices).all():
+        raise ValueError("Invalid mesh vertices")
+    if faces.ndim != 2 or faces.shape[1] != 3 or len(faces) == 0:
+        raise ValueError("Mesh must contain triangular faces")
+    if not np.issubdtype(faces.dtype, np.integer) or faces.min() < 0 or faces.max() >= len(vertices):
+        raise ValueError("Invalid mesh connectivity indices")
+    repeated = (faces[:, 0] == faces[:, 1]) | (faces[:, 1] == faces[:, 2]) | (faces[:, 2] == faces[:, 0])
+    if repeated.any():
+        raise ValueError("Mesh face repeats a vertex")
+    edges = np.sort(np.concatenate((faces[:, [0, 1]], faces[:, [1, 2]], faces[:, [2, 0]])), axis=1)
+    edges, incidence = np.unique(edges, axis=0, return_counts=True)
+    graph = coo_matrix((np.ones(len(edges), dtype=np.uint8), (edges[:, 0], edges[:, 1])),
+                       shape=(len(vertices), len(vertices)))
+    components, labels = connected_components(graph, directed=False)
+    areas = np.linalg.norm(np.cross(vertices[faces[:, 1]] - vertices[faces[:, 0]],
+                                    vertices[faces[:, 2]] - vertices[faces[:, 0]]), axis=1)
+    return {"vertices": len(vertices), "faces": len(faces), "components": int(components),
+            "largest_component_vertices": int(np.bincount(labels).max()),
+            "unreferenced_vertices": int(len(vertices) - len(np.unique(faces))),
+            "boundary_edges": int(np.count_nonzero(incidence == 1)),
+            "nonmanifold_edges": int(np.count_nonzero(incidence > 2)),
+            "zero_area_faces": int(np.count_nonzero(areas == 0))}
