+    def cap_primitives(self, max_primitives):
+        if max_primitives <= 0 or self.get_convex_points.shape[0] <= max_primitives:
+            return
+        scores = self.get_opacity.squeeze(-1) * torch.sigmoid(self._mask).squeeze(-1)
